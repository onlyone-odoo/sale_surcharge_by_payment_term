<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payment_term_form_inherit_surcharge" model="ir.ui.view">
        <field name="name">account.payment.term.form.inherit.surcharge</field>
        <field name="model">account.payment.term</field>
        <field name="inherit_id" ref="account.view_payment_term_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='line_ids']" position="after">
                <group string="Surcharge Options">
                    <field name="surcharge_percentage"/>
                    <field name="surcharge_product_id"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>